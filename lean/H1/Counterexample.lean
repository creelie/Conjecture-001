theorem p1_3_not_mem : p1_3 ∉ D := fun h => absurd ((mem_D _).1 h) (by decide +kernel)

theorem p2_7_not_mem : p2_7 ∉ D := fun h => absurd ((mem_D _).1 h) (by decide +kernel)

/-- The complement of `D` has no least element: `p1_3` and `p2_7` lie outside `D`, and
every common lower bound of them lies in `D`. -/
theorem no_least : ¬∃ z : L, z ∉ D ∧ ∀ c : L, c ∉ D → z ≤ c := by
  rintro ⟨z, hz, h⟩
  have key : ∀ z : L, z ≤ p1_3 → z ≤ p2_7 → inD z = true := by decide +kernel
  exact hz (key z (h _ p1_3_not_mem) (h _ p2_7_not_mem))

/-- The complement of the maximal sublattice `D` is not an interval. -/
theorem not_interval : ¬∃ u v : L, ∀ x : L, x ∉ D ↔ u ≤ x ∧ x ≤ v := by
  rintro ⟨u, v, h⟩
  refine no_least ⟨u, ?_, fun c hc => ((h c).1 hc).1⟩
  have hu := ((h p1_3).1 p1_3_not_mem)
  exact (h u).2 ⟨le_rfl, hu.1.trans hu.2⟩

end L

/-- **The question of Adams, Freese, Nation and Schmid has a negative answer**: there is a finite
semidistributive lattice with a maximal proper sublattice whose complement is not an interval. -/
theorem not_complement_interval :
    ¬∀ (α : Type) [Lattice α] [Finite α],
      (∀ a b c : α, a ⊔ b = a ⊔ c → a ⊔ b = a ⊔ (b ⊓ c)) →
      (∀ a b c : α, a ⊓ b = a ⊓ c → a ⊓ b = a ⊓ (b ⊔ c)) →
      ∀ M : Sublattice α, IsCoatom M → ∃ u v : α, ∀ x : α, x ∉ M ↔ u ≤ x ∧ x ≤ v :=
  fun h => L.not_interval (h L L.sdSup L.sdInf L.D L.isCoatom_D)

end H1
